    "codes": {
      "shape": {
        "code": "DEMO25",
        "label": "Demo Town Little League",
        "type": "fixed_price | percent_off",
        "value": "180 for fixed_price, 10 for percent_off",
        "applies_to": "option id, or '*' for every option on the program",
        "scope": "program slug",
        "expires": "ISO date",
        "max_uses": "integer or null",
        "per_player": "true if the discount applies to each player on the registration, false if once per registration"
      },
      "security": [
        "Lookup is server side. Code in, one price out. Never a list.",
        "One identical failure message whatever the cause. Never existed, expired, wrong program and reserved places gone all read the same.",
        "Constant time comparison. Rate limited to 5 attempts per minute per IP. Every attempt logged with a hashed IP.",
        "No rate, discount or code ever appears in page HTML, JSON, the sitemap or any queryable API."
      ],
      "known": "Not recorded here. This file is served publicly, so no real code, rate or town name may appear in it. Known rates stay in the meeting notes they came from until the code system exists to hold them privately."
    },
    "multi_player": {
      "max": 4,
      "source": "Meeting notes, 21 September. Families can add up to four players in one session.",
      "pricing": "Total is the sum per player. Whether a code applies per player or once per registration is the per_player flag on the code.",
      "waiver": "One waiver per player, not one per registration."
    }
